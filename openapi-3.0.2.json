  "components": {
    "schemas": {
      "BankIn": {
        "properties": {
          "card_number": {
            "type": "string",
            "title": "Card Number",
            "description": "16~19 位银行卡号",
            "example": "6222020200112233445"
          }
        },
        "type": "object",
        "required": [
          "card_number"
        ],
        "title": "BankIn"
      },
      "FakeIn": {
        "properties": {
          "kind": {
            "type": "string",
            "title": "Kind",
            "description": "name / phone / idcard / company / address / all",
            "default": "name"
          },
          "count": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Count",
            "description": "生成数量，1~100",
            "default": 5
          }
        },
        "type": "object",
        "title": "FakeIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IdIn": {
        "properties": {
          "id_number": {
            "type": "string",
            "title": "Id Number",
            "description": "18 位身份证号",
            "example": "11010519491231002X"
          }
        },
        "type": "object",
        "required": [
          "id_number"
        ],
        "title": "IdIn"
      },
      "MaskIn": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text",
            "description": "需要脱敏的文本"
          },
          "mask_char": {
            "type": "string",
            "maxLength": 1,
            "title": "Mask Char",
            "description": "打码用的字符，默认 *",
            "default": "*"
          },
          "keep_head": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Keep Head",
            "description": "保留前几位（手机/银行卡）",
            "default": 3
          },
          "keep_tail": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Keep Tail",
            "description": "保留后几位",
            "default": 4
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "MaskIn"
      },
      "PhoneIn": {
        "properties": {
          "phone": {
            "type": "string",
            "title": "Phone",
            "description": "11 位手机号",
            "example": "13812345678"
          }
        },
        "type": "object",
        "required": [
          "phone"
        ],
        "title": "PhoneIn"
      },
      "PinyinIn": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text",
            "description": "中文文本",
            "example": "中国银行"
          },
          "style": {
            "type": "string",
            "title": "Style",
            "description": "plain=不带声调 / tone=带声调数字 / first=首字母",
            "default": "plain"
          },
          "separator": {
            "type": "string",
            "title": "Separator",
            "description": "拼音之间的分隔符",
            "default": " "
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "PinyinIn"
      },
      "TextIn": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text",
            "description": "待处理文本",
            "example": "联系我 13812345678 或 a@b.com"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "TextIn"
      },
      "UsccIn": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "18 位统一社会信用代码",
            "example": "91350100M000100Y43"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "UsccIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}