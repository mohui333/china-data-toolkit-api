      }
    },
    "/v1/validate/bankcard": {
      "post": {
        "tags": [
          "校验"
        ],
        "summary": "Validate Bankcard",
        "description": "银行卡号 Luhn 校验",
        "operationId": "validate_bankcard_v1_validate_bankcard_post",
        "requestBody": {
